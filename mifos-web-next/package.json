{
  "name": "mifos-web-next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js Fineract web client — greenfield replacement for Mifos X Web App",
  "license": "MPL-2.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:webpack": "pnpm --filter web dev:webpack",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm run typecheck",
    "check:lint": "pnpm run lint",
    "check:ci": "pnpm run typecheck && pnpm run build",
    "check:pre-commit": "node scripts/pre-commit-check.mjs",
    "clean": "pnpm --filter web clean",
    "format": "prettier --write .",
    "prepare": "node scripts/ensure-git-hooks.mjs",
    "routes:parity": "pnpm exec tsx tooling/routes-inventory/generate-parity.ts",
    "vercel-build": "pnpm --filter web build"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
