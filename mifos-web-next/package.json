{
  "name": "mifos-web-next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js Fineract web client \u2014 greenfield replacement for Mifos X Web App",
  "license": "MPL-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "routes:parity": "npx tsx tooling/routes-inventory/generate-parity.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
