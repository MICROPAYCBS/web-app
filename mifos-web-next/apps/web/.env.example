# Micropay Uganda location cascade (client-side locations.json). Set to false to use Fineract field config only.
NEXT_PUBLIC_USE_LOCATION_CASCADE=true

# Idle session sign-out (client-side). Set timeout minutes to 0 to disable.
# NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=15
# NEXT_PUBLIC_SESSION_IDLE_WARNING_SECONDS=60

# Fineract (SERVER ONLY — never NEXT_PUBLIC_*)
FINERACT_API_URL=https://localhost:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
# Dev: allow self-signed HTTPS to Fineract (default in NODE_ENV=development). Set FINERACT_STRICT_TLS=1 to require valid certificates.

# RBAC (see docs/RBAC.md)
# RBAC_ENABLED=false
RBAC_DEV_SESSION={"userId":1,"username":"dev","officeId":1,"permissions":["ALL_FUNCTIONS"]}

# Sentry (Production only — set env vars on Vercel → Production, not Preview)
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=...          # Production build env — uploads source maps
# SENTRY_ENABLED=false           # emergency kill switch on production
# SENTRY_TRACES_SAMPLE_RATE=0.1  # 0–1
# SENTRY_TUNNEL_ROUTE=/monitoring

# Vercel preview (see .env.vercel.example and docs/DEPLOYMENT.md)
# DEMO_SESSION_ENABLED=true
# FINERACT_SERVERS=[{"id":"demo","name":"Mifos Demo","baseUrl":"https://demo.mifos.community/fineract-provider/api/v1","tenantId":"default"}]
