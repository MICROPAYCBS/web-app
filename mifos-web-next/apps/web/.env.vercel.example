# Copy these into Vercel → Project → Settings → Environment Variables
# Apply to Production, Preview, and Development as noted.

# --- Demo Fineract (Preview / early Production) ---
# Public Mifos demo — BFF calls this from Vercel servers (not the browser).
FINERACT_API_URL=https://demo.mifos.community/fineract-provider/api/v1
FINERACT_TENANT_ID=default

# Pre-seed the server picker (JSON array, one line)
FINERACT_SERVERS=[{"id":"demo","name":"Mifos Community Demo","baseUrl":"https://demo.mifos.community/fineract-provider/api/v1","tenantId":"default"}]

# --- Demo session (Preview only until real login ships) ---
# Do NOT enable DEMO_SESSION_ENABLED on a real production tenant.
DEMO_SESSION_ENABLED=true
RBAC_DEV_SESSION={"userId":1,"username":"demo","officeId":1,"permissions":["ALL_FUNCTIONS"]}

# Optional: disable RBAC checks while iterating
# RBAC_ENABLED=false
