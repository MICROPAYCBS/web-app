{
  "command": "clients.recurring-deposit-account.create",
  "fineractSources": [
    "org.apache.fineract.portfolio.savings.api.RecurringDepositAccountsApiResource",
    "org.apache.fineract.portfolio.savings.data.DepositAccountDataValidator"
  ],
  "fields": {
    "productId": { "required": true },
    "submittedOnDate": { "required": true },
    "depositAmount": { "required": true, "min": 0 },
    "depositPeriod": { "required": true, "min": 1 },
    "depositPeriodFrequencyId": { "required": true },
    "recurringFrequency": { "required": true, "min": 1 },
    "recurringFrequencyType": { "required": true },
    "mandatoryRecommendedDepositAmount": { "required": true, "min": 0 }
  }
}
