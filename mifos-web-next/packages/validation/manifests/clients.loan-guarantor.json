    "firstname": { "required": false, "maxLength": 50 },
    "lastname": { "required": false, "maxLength": 50 },
    "nationalIdNumber": { "required": false, "maxLength": 50, "requiredWhen": "guarantorTypeId=3" },
    "addressLine1": { "required": false, "maxLength": 500 },
    "addressLine2": { "required": false, "maxLength": 500 },
    "city": { "required": false, "maxLength": 50 },
    "state": { "required": false, "maxLength": 50 },
    "country": { "required": false, "maxLength": 50 },
    "zip": { "required": false, "maxLength": 20 },
    "mobileNumber": { "required": false, "maxLength": 20 },
    "housePhoneNumber": { "required": false, "maxLength": 20 },
