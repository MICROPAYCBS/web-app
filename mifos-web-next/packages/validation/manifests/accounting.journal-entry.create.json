    "creditOfficeId": { "required": true },
    "creditDepartmentId": { "required": false },
    "currencyCode": { "required": true },
    "transactionDate": { "required": true },
    "debits": { "required": true },
    "debits[].comments": { "required": false, "maxLength": 500 },
    "credits": { "required": true },
    "credits[].comments": { "required": false, "maxLength": 500 },
    "referenceNumber": { "required": false },
    "paymentTypeId": { "required": false },
    "accountNumber": { "required": false },
    "checkNumber": { "required": false },
    "routingCode": { "required": false },
    "receiptNumber": { "required": false },
    "bankNumber": { "required": false },
