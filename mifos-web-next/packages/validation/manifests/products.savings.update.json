{
  "command": "products.savings.update",
  "fineractSources": [
    "org.apache.fineract.portfolio.savings.api.SavingsProductsApiResource",
    "org.apache.fineract.portfolio.savings.data.SavingsProductDataValidator"
  ],
  "fields": {
    "name": { "required": true, "maxLength": 100 },
    "shortName": { "required": true, "maxLength": 4 },
    "description": { "maxLength": 500 },
    "startDate": { "required": false, "type": "date" },
    "closeDate": { "required": false, "type": "date" },
    "currencyCode": { "required": true, "maxLength": 3 },
    "digitsAfterDecimal": { "required": true, "min": 0, "max": 6 },
    "nominalAnnualInterestRate": { "required": true, "min": 0 },
    "interestCompoundingPeriodType": { "required": true },
    "interestPostingPeriodType": { "required": true },
    "interestCalculationType": { "required": true },
    "interestCalculationDaysInYearType": { "required": true },
    "accountingRule": { "required": true }
  }
}
