{
  "command": "products.charge.update",
  "fineractSources": [
    "org.apache.fineract.portfolio.charge.api.ChargesApiResource",
    "org.apache.fineract.portfolio.charge.domain.Charge",
    "org.apache.fineract.portfolio.charge.domain.ChargeTier"
  ],
  "fields": {
    "name": { "required": true },
    "currencyCode": { "required": true },
    "chargeTimeType": { "required": true },
    "chargeCalculationType": { "required": true },
    "amount": { "required": true },
    "active": { "required": false },
    "penalty": { "required": false },
    "useChargeTiers": { "required": false },
    "chargeTiers": { "required": false },
    "minCap": { "required": false },
    "maxCap": { "required": false },
    "chargeAppliesTo": { "required": false, "notes": "Cannot change. Resend the current value when the body also includes charge time and tiers." },
    "chargePaymentMode": { "required": false },
    "feeOnMonthDay": { "required": false },
    "feeInterval": { "required": false },
    "feeFrequency": { "required": false },
    "enableFreeWithdrawalCharge": { "required": false },
    "freeWithdrawalFrequency": { "required": false },
    "restartCountFrequency": { "required": false },
    "countFrequencyType": { "required": false },
    "enablePaymentType": { "required": false },
    "paymentTypeId": { "required": false },
    "incomeAccountId": { "required": false },
    "taxGroupId": { "required": false, "notes": "Cannot change once a tax group is already set." }
  }
}
