{
  "schemaId": "organization.staff.update",
  "fineractSources": [
    "org.apache.fineract.organisation.staff.api.StaffApiResource",
    "org.apache.fineract.organisation.staff.domain.Staff"
  ],
  "fields": {
    "officeId": { "required": true, "type": "integer" },
    "firstname": { "required": true, "maxLength": 50 },
    "lastname": { "required": true, "maxLength": 50 },
    "isLoanOfficer": { "required": false, "type": "boolean" },
    "mobileNo": { "required": false, "maxLength": 13, "format": "ugandaInternationalPhone" },
    "joiningDate": { "required": true, "type": "date" },
    "isActive": { "required": true, "type": "boolean" }
  }
}
