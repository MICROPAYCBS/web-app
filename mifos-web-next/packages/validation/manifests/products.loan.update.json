{
  "command": "products.loan.update",
  "fineractSources": [
    "org.apache.fineract.portfolio.loanproduct.api.LoanProductsApiResource",
    "org.apache.fineract.portfolio.loanproduct.serialization.LoanProductDataValidator",
    "org.apache.fineract.portfolio.common.domain.PeriodFrequencyType",
    "org.apache.fineract.portfolio.common.domain.DaysInYearType",
    "org.apache.fineract.portfolio.common.domain.DaysInMonthType"
  ],
  "fields": {
    "name": { "required": true, "maxLength": 100 },
    "shortName": { "required": true, "maxLength": 4 },
    "description": { "maxLength": 500 },
    "currencyCode": { "required": true, "maxLength": 3 },
    "digitsAfterDecimal": { "required": true, "min": 0, "max": 6 },
    "principal": { "required": true, "min": 0 },
    "numberOfRepayments": { "required": true, "min": 1 },
    "repaymentEvery": { "required": true, "min": 1 },
    "repaymentFrequencyType": { "required": true, "min": 0, "max": 3 },
    "interestRatePerPeriod": { "requiredWhen": "fixedInterest" },
    "interestRateFrequencyType": { "requiredWhen": "fixedInterest", "min": 0, "max": 4 },
    "amortizationType": { "required": true, "min": 0, "max": 1 },
    "interestType": { "required": true, "min": 0, "max": 1 },
    "interestCalculationPeriodType": { "required": true, "min": 0, "max": 1 },
    "transactionProcessingStrategyCode": { "required": true },
    "daysInYearType": { "required": true, "allowedValues": [1, 360, 364, 365] },
    "daysInMonthType": { "required": true, "allowedValues": [1, 30] },
    "loanScheduleType": { "required": true },
    "accountingRule": { "required": true },
    "enableDownPayment": { "required": false },
    "disbursedAmountPercentageForDownPayment": {
      "requiredWhen": "enableDownPayment",
      "min": 1,
      "max": 100
    },
    "enableAutoRepaymentForDownPayment": { "required": false }
  }
}
