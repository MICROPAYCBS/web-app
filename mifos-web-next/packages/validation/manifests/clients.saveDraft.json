{
  "command": "clients.create",
  "fineractSources": [
    "org.apache.fineract.portfolio.client.api.ClientsApiResource",
    "org.apache.fineract.portfolio.client.domain.ClientStatus"
  ],
  "fields": {
    "officeId": { "required": true },
    "staffId": { "required": false },
    "legalFormId": { "required": true, "values": [1, 2] },
    "firstname": { "requiredWhen": "legalFormId=1" },
    "lastname": { "requiredWhen": "legalFormId=1" },
    "fullname": { "requiredWhen": "legalFormId=2" },
    "clientNonPersonDetails.constitutionId": { "requiredWhen": "legalFormId=2" },
    "submittedOnDate": { "required": true },
    "customerClassId": { "required": false },
    "dateOfBirth": { "required": false },
    "familyMembers": { "required": false },
    "clientIdentifiers": { "required": false },
    "address": { "required": false },
    "datatables": { "required": false },
    "active": { "required": false, "default": false }
  },
  "notes": "Soft draft create via POST /clients (active omitted/false) → ClientStatus Draft (50)."
}
