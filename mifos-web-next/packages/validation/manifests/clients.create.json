{
  "command": "clients.create",
  "fineractSources": [
    "org.apache.fineract.portfolio.client.command.CreateClientCommand",
    "org.apache.fineract.portfolio.client.domain.Client"
  ],
  "fields": {
    "officeId": { "required": true },
    "staffId": { "required": true },
    "mobileNo": { "required": true, "maxLength": 13, "format": "ugandaInternationalMobile" },
    "taxIdentificationNumber": { "required": false, "maxLength": 50 },
    "alternativeMobileNo": { "required": false, "maxLength": 13, "format": "ugandaInternationalMobile" },
    "alternativeEmailAddress": { "required": false, "maxLength": 50 },
    "subIndustryId": { "required": false },
    "incomeSources": { "required": false },
    "dateOfBirth": { "required": true },
    "genderId": { "requiredWhen": "legalFormId=1" },
    "customerClassId": { "required": true },
    "legalFormId": { "required": true, "values": [1, 2] },
    "firstname": { "requiredWhen": "legalFormId=1" },
    "lastname": { "requiredWhen": "legalFormId=1" },
    "fullname": { "requiredWhen": "legalFormId=2" },
    "clientNonPersonDetails.constitutionId": { "requiredWhen": "legalFormId=2" },
    "submittedOnDate": { "required": true },
    "active": { "required": false },
    "activationDate": { "requiredWhen": "active=true" },
    "savingsProductId": { "requiredWhen": "openSavingsOnCreate=true" },
    "familyMembers": { "required": false },
    "address": { "requiredWhen": "isAddressEnabled=true" },
    "datatables": { "required": false }
  }
}
