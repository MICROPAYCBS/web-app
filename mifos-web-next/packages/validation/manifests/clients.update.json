{
  "command": "clients.update",
  "fineractSources": [
    "org.apache.fineract.portfolio.client.command.UpdateClientCommand",
    "org.apache.fineract.portfolio.client.domain.Client"
  ],
  "fields": {
    "legalFormId": { "required": true, "values": [1, 2], "note": "Read-only in UI; sent for discriminated validation only" },
    "firstname": { "requiredWhen": "legalFormId=1" },
    "lastname": { "requiredWhen": "legalFormId=1" },
    "fullname": { "requiredWhen": "legalFormId=2" },
    "clientNonPersonDetails.constitutionId": { "requiredWhen": "legalFormId=2" },
    "submittedOnDate": { "required": true },
    "active": { "required": true },
    "activationDate": { "requiredWhen": "active=true" }
  }
}
