{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mifos.org/schemas/fineract-validation-manifest.json",
  "title": "FineractValidationManifest",
  "type": "object",
  "required": ["command", "fineractSources", "fields"],
  "properties": {
    "command": {
      "type": "string",
      "description": "Stable command id, e.g. clients.create"
    },
    "fineractSources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Java classes or files reviewed for rules"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": { "type": "boolean" },
          "maxLength": { "type": "integer", "minimum": 1 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "pattern": { "type": "string" },
          "requiredWhen": {
            "type": "string",
            "description": "Expression documented in Fineract, e.g. active=true"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
